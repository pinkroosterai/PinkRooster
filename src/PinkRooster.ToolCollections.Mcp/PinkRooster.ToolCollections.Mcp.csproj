<Project Sdk="Microsoft.NET.Sdk">

  <!-- The only src project allowed to reference MCP; NeutralityTests keeps it out of the rest. -->
  <PropertyGroup>
    <PackageId>PinkRooster.ToolCollections.Mcp</PackageId>
    <Description>Use MCP (Model Context Protocol) servers as tools for AI agents on the Microsoft Agent Framework. Connect over HTTP or stdio; the server's tools and instructions become a tool collection with approvals, renaming and context.</Description>
    <PackageTags>mcp model-context-protocol mcp-client ai-agents tool-calling agent-framework microsoft-agent-framework llm dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\PinkRooster.ToolCollections.Mcp.md" Pack="true" PackagePath="/README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PinkRooster.ToolCollections\PinkRooster.ToolCollections.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PinkRooster.ToolCollections.Mcp.Tests" />
  </ItemGroup>

</Project>
