<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>PinkRooster.ToolCollections.BuiltIn</PackageId>
    <Description>Ready-made tool collections for AI agents on the Microsoft Agent Framework: run shell commands with limits and approvals, read, search and edit files inside a sandboxed workspace, ask the user multiple-choice questions, keep a token-efficient task list with pluggable storage, tell the time, and ask a vision-capable model about image files. No model-provider or UI dependencies.</Description>
    <PackageTags>ai-agents tools shell file-operations human-in-the-loop task-list todo datetime image vision agent-framework microsoft-agent-framework tool-calling llm dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\PinkRooster.ToolCollections.BuiltIn.md" Pack="true" PackagePath="/README.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PinkRooster.ToolCollections\PinkRooster.ToolCollections.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PinkRooster.ToolCollections.BuiltIn.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
  </ItemGroup>

</Project>
