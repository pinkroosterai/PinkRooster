<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- xUnit1051: ported tests call APIs without TestContext.Current.CancellationToken; kept as-is so their bodies match the old repo. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PinkRooster.Agents\PinkRooster.Agents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tool collections the ToolCollections tests define are also driven through an agent here. -->
    <Compile Include="..\PinkRooster.ToolCollections.Tests\TestCollections.cs" Link="TestSupport\TestCollections.cs" />
  </ItemGroup>

</Project>
